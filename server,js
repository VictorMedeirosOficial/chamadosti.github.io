/**
 * ============================================================================
 * SERVIDOR BACKEND NODE.JS + MYSQL (PRÉ-CONFIGURADO PARA LOCALHOST E REDE LAN)
 * ============================================================================
 * Como iniciar:
 *   1. Certifique-se de que o MySQL está rodando (ex: XAMPP / MySQL Server)
 *   2. Execute: npm install
 *   3. Execute: npm start
 *   4. Acesse no navegador: http://localhost:3000
 */

require('dotenv').config();
const express = require('express');
const cors = require('cors');
const mysql = require('mysql2/promise');
const path = require('path');
const os = require('os');

const app = express();
const PORT = process.env.PORT || 3000;
const HOST = process.env.HOST || '0.0.0.0';

// Middlewares: CORS liberado para acesso via localhost e qualquer IP da rede local
app.use(cors({ origin: '*' }));
app.use(express.json({ limit: '15mb' }));
app.use(express.urlencoded({ extended: true, limit: '15mb' }));

// Servir os arquivos estáticos do site na raiz
app.use(express.static(path.join(__dirname)));

// Configuração do Pool de Conexão MySQL (Pré-configurado para localhost)
const dbConfig = {
  host: process.env.DB_HOST || 'localhost',
  port: Number(process.env.DB_PORT || 3306),
  user: process.env.DB_USER || 'root',
  password: process.env.DB_PASSWORD || '',
  database: process.env.DB_NAME || 'helpdesk_ti',
  waitForConnections: true,
  connectionLimit: 10,
  queueLimit: 0
};

let pool = null;

async function inicializarBancoMySQL() {
  try {
    // Cria o banco automaticamente caso ainda não exista
    const tempConn = await mysql.createConnection({
      host: dbConfig.host,
      port: dbConfig.port,
      user: dbConfig.user,
      password: dbConfig.password
    });
    await tempConn.query(`CREATE DATABASE IF NOT EXISTS \`${dbConfig.database}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;`);
    await tempConn.end();

    pool = mysql.createPool(dbConfig);

    // Garante que as tabelas existam
    await pool.query(`
      CREATE TABLE IF NOT EXISTS configuracoes_ti (
        id INT PRIMARY KEY DEFAULT 1,
        nome_tecnico VARCHAR(120) NOT NULL DEFAULT 'Lucas Silva',
        cargo_tecnico VARCHAR(120) NOT NULL DEFAULT 'Analista de Suporte TI',
        ramal_tecnico VARCHAR(40) NOT NULL DEFAULT '2044',
        foto_ti LONGTEXT NULL,
        atualizado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
      ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
    `);

    await pool.query(`
      INSERT IGNORE INTO configuracoes_ti (id, nome_tecnico, cargo_tecnico, ramal_tecnico)
      VALUES (1, 'Lucas Silva', 'Analista de Suporte TI', '2044');
    `);

    await pool.query(`
      CREATE TABLE IF NOT EXISTS colaboradores (
        id VARCHAR(50) PRIMARY KEY,
        nome VARCHAR(120) NOT NULL,
        funcao VARCHAR(100) DEFAULT 'Colaborador / Ajudante',
        setor VARCHAR(100) DEFAULT 'Suporte / Apoio',
        ramal VARCHAR(40) DEFAULT '',
        cor_badge VARCHAR(40) DEFAULT 'blue',
        criado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP
      ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
    `);

    await pool.query(`
      CREATE TABLE IF NOT EXISTS chamados (
        id VARCHAR(40) PRIMARY KEY,
        setor VARCHAR(150) NOT NULL,
        responsavel VARCHAR(150) NOT NULL,
        categoria VARCHAR(50) NOT NULL,
        urgencia VARCHAR(30) NOT NULL DEFAULT 'Normal',
        descricao TEXT NULL,
        status VARCHAR(30) NOT NULL DEFAULT 'aberto',
        resultado VARCHAR(30) NULL DEFAULT NULL,
        parecer_tecnico TEXT NULL,
        ajudantes_json LONGTEXT NULL,
        comentarios_json LONGTEXT NULL,
        data_abertura VARCHAR(40) NOT NULL,
        data_resolucao VARCHAR(40) NULL DEFAULT NULL,
        criado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP
      ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
    `);

    console.log('✅ [MySQL] Conectado e sincronizado com sucesso em ' + dbConfig.host + ':' + dbConfig.port + '/' + dbConfig.database);
  } catch (err) {
    console.warn('⚠️ [MySQL] Aviso: Não foi possível conectar ao MySQL agora (' + err.message + '). Verifique se o MySQL (XAMPP/Serviço) está ativo.');
  }
}

// Rota de Status (Ping de Conexão Localhost + MySQL)
app.get('/api/status', async (req, res) => {
  try {
    if (!pool) await inicializarBancoMySQL();
    if (pool) {
      await pool.query('SELECT 1');
      return res.json({ ok: true, mysql: true, host: dbConfig.host, database: dbConfig.database, msg: 'Conectado ao MySQL no Localhost!' });
    }
    res.status(503).json({ ok: false, mysql: false, msg: 'Servidor Node ativo, aguardando MySQL iniciar.' });
  } catch (err) {
    res.status(500).json({ ok: false, mysql: false, error: err.message });
  }
});

// Buscar todos os dados (Chamados, Colaboradores e Perfil do TI)
app.get('/api/dados', async (req, res) => {
  try {
    const [chamadosRows] = await pool.query('SELECT * FROM chamados ORDER BY criado_em DESC');
    const [colabRows] = await pool.query('SELECT * FROM colaboradores ORDER BY criado_em ASC');
    const [configRows] = await pool.query('SELECT * FROM configuracoes_ti WHERE id = 1');

    const chamados = chamadosRows.map(r => ({
      id: r.id,
      setor: r.setor,
      responsavel: r.responsavel,
      categoria: r.categoria,
      urgencia: r.urgencia || 'Normal',
      descricao: r.descricao || '',
      status: r.status,
      resultado: r.resultado,
      parecerTecnico: r.parecer_tecnico || '',
      ajudantes: r.ajudantes_json ? JSON.parse(r.ajudantes_json) : [],
      comentarios: r.comentarios_json ? JSON.parse(r.comentarios_json) : [],
      dataAbertura: r.data_abertura,
      dataResolucao: r.data_resolucao
    }));

    res.json({
      ok: true,
      chamados,
      colaboradores: colabRows,
      perfilTI: configRows[0] || null
    });
  } catch (err) {
    res.status(500).json({ ok: false, error: err.message });
  }
});

// Sincronizar / Salvar Chamado no MySQL
app.post('/api/chamados', async (req, res) => {
  try {
    const c = req.body;
    await pool.query(
      `INSERT INTO chamados (id, setor, responsavel, categoria, urgencia, descricao, status, resultado, parecer_tecnico, ajudantes_json, comentarios_json, data_abertura, data_resolucao)
       VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
       ON DUPLICATE KEY UPDATE
         setor = VALUES(setor),
         responsavel = VALUES(responsavel),
         categoria = VALUES(categoria),
         urgencia = VALUES(urgencia),
         descricao = VALUES(descricao),
         status = VALUES(status),
         resultado = VALUES(resultado),
         parecer_tecnico = VALUES(parecer_tecnico),
         ajudantes_json = VALUES(ajudantes_json),
         comentarios_json = VALUES(comentarios_json),
         data_resolucao = VALUES(data_resolucao)`,
      [
        c.id,
        c.setor,
        c.responsavel,
        c.categoria,
        c.urgencia || 'Normal',
        c.descricao || '',
        c.status || 'aberto',
        c.resultado || null,
        c.parecerTecnico || '',
        JSON.stringify(c.ajudantes || []),
        JSON.stringify(c.comentarios || []),
        c.dataAbertura,
        c.dataResolucao || null
      ]
    );
    res.json({ ok: true, id: c.id });
  } catch (err) {
    res.status(500).json({ ok: false, error: err.message });
  }
});

// Sincronização em lote (Todos os chamados, colaboradores e perfil TI)
app.post('/api/sincronizar', async (req, res) => {
  try {
    const { chamados = [], colaboradores = [], perfilTI = null } = req.body;

    if (perfilTI) {
      await pool.query(
        `UPDATE configuracoes_ti SET nome_tecnico = ?, cargo_tecnico = ?, ramal_tecnico = ?, foto_ti = ? WHERE id = 1`,
        [perfilTI.nome || 'Lucas Silva', perfilTI.cargo || 'Analista de Suporte TI', perfilTI.ramal || '2044', perfilTI.foto || null]
      );
    }

    for (const col of colaboradores) {
      await pool.query(
        `INSERT INTO colaboradores (id, nome, funcao, setor, ramal, cor_badge)
         VALUES (?, ?, ?, ?, ?, ?)
         ON DUPLICATE KEY UPDATE nome = VALUES(nome), funcao = VALUES(funcao), setor = VALUES(setor), ramal = VALUES(ramal)`,
        [col.id, col.nome, col.funcao || 'Ajudante', col.setor || 'TI', col.ramal || '', col.cor || 'blue']
      );
    }

    for (const c of chamados) {
      await pool.query(
        `INSERT INTO chamados (id, setor, responsavel, categoria, urgencia, descricao, status, resultado, parecer_tecnico, ajudantes_json, comentarios_json, data_abertura, data_resolucao)
         VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
         ON DUPLICATE KEY UPDATE
           status = VALUES(status),
           resultado = VALUES(resultado),
           parecer_tecnico = VALUES(parecer_tecnico),
           ajudantes_json = VALUES(ajudantes_json),
           comentarios_json = VALUES(comentarios_json),
           data_resolucao = VALUES(data_resolucao)`,
        [
          c.id, c.setor, c.responsavel, c.categoria, c.urgencia || 'Normal',
          c.descricao || '', c.status || 'aberto', c.resultado || null,
          c.parecerTecnico || '', JSON.stringify(c.ajudantes || []),
          JSON.stringify(c.comentarios || []), c.dataAbertura, c.dataResolucao || null
        ]
      );
    }

    res.json({ ok: true, msg: 'Dados sincronizados com sucesso no MySQL!' });
  } catch (err) {
    res.status(500).json({ ok: false, error: err.message });
  }
});

// Atualizar Foto e Perfil do TI
app.put('/api/config/ti-perfil', async (req, res) => {
  try {
    const { nome, cargo, ramal, foto } = req.body;
    await pool.query(
      `UPDATE configuracoes_ti SET nome_tecnico = ?, cargo_tecnico = ?, ramal_tecnico = ?, foto_ti = ? WHERE id = 1`,
      [nome || 'Lucas Silva', cargo || 'Analista de Suporte TI', ramal || '2044', foto || null]
    );
    res.json({ ok: true });
  } catch (err) {
    res.status(500).json({ ok: false, error: err.message });
  }
});

// Descobrir IPs da máquina para exibir no terminal
function obterIPsRedeLocal() {
  const interfaces = os.networkInterfaces();
  const ips = [];
  for (const name of Object.keys(interfaces)) {
    for (const iface of interfaces[name]) {
      if (iface.family === 'IPv4' && !iface.internal) {
        ips.push(iface.address);
      }
    }
  }
  return ips;
}

app.listen(PORT, HOST, async () => {
  await inicializarBancoMySQL();
  const ips = obterIPsRedeLocal();
  console.log('====================================================================');
  console.log('🚀 SERVIDOR HELPDESK TI + MYSQL INICIADO COM SUCESSO!');
  console.log(`💻 Acesso Local (Esta Máquina): http://localhost:${PORT}`);
  ips.forEach(ip => {
    console.log(`🌐 Acesso na Rede da Empresa:   http://${ip}:${PORT}`);
  });
  console.log('====================================================================');
});
