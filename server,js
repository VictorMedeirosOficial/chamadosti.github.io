const dbConfig = {
  host: process.env.DB_HOST || 'localhost',
  port: Number(process.env.DB_PORT || 3306),
  user: process.env.DB_USER || 'root',
  password: process.env.DB_PASSWORD || '',
  database: process.env.DB_NAME || 'helpdesk_ti',
  waitForConnections: true,
  connectionLimit: 10,
  queueLimit: 0
};[cite: 2]

let pool = null;[cite: 2]
let mysqlAtivo = false;[cite: 2]

function lerBackupJson() {
  try {
    if (fs.existsSync(JSON_BACKUP_FILE)) {
      return JSON.parse(fs.readFileSync(JSON_BACKUP_FILE, 'utf-8'));
    }
  } catch (e) {}
  return { chamados: [], colaboradores: [], perfilTI: null };
}[cite: 2]

function salvarBackupJson(dados) {
  try {
    fs.mkdirSync(path.dirname(JSON_BACKUP_FILE), { recursive: true });
    fs.writeFileSync(JSON_BACKUP_FILE, JSON.stringify(dados, null, 2), 'utf-8');
  } catch (e) {}
}[cite: 2]

async function inicializarBancoMySQL(customDbName) {
  const targetDb = (customDbName || dbConfig.database || 'helpdesk_ti').replace(/[^a-zA-Z0-9_]/g, '');
  try {
    const tempConn = await mysql.createConnection({
      host: dbConfig.host,
      port: dbConfig.port,
      user: dbConfig.user,
      password: dbConfig.password
    });
    await tempConn.query(`CREATE DATABASE IF NOT EXISTS \`${targetDb}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;`);
    await tempConn.end();

    pool = mysql.createPool({ ...dbConfig, database: targetDb });

    await pool.query(`
      CREATE TABLE IF NOT EXISTS configuracoes_ti (
        id INT PRIMARY KEY DEFAULT 1,
        nome_tecnico VARCHAR(120) NOT NULL DEFAULT 'João Victor',
        cargo_tecnico VARCHAR(120) NOT NULL DEFAULT 'Analista de Suporte TI',
        foto_ti LONGTEXT NULL,
        atualizado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
      ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
    `);

    await pool.query(`
      INSERT IGNORE INTO configuracoes_ti (id, nome_tecnico, cargo_tecnico)
      VALUES (1, 'João Victor', 'Analista de Suporte TI');
    `);

    await pool.query(`
      CREATE TABLE IF NOT EXISTS colaboradores (
        id VARCHAR(50) PRIMARY KEY,
        nome VARCHAR(120) NOT NULL,
        funcao VARCHAR(120) DEFAULT 'Colaborador TI',
        criado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP
      ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
    `);

    await pool.query(`
      CREATE TABLE IF NOT EXISTS chamados (
        id VARCHAR(40) PRIMARY KEY,
        setor VARCHAR(150) NOT NULL,
        responsavel VARCHAR(150) NOT NULL,
        categoria VARCHAR(50) NOT NULL,
        descricao TEXT NULL,
        status VARCHAR(30) NOT NULL DEFAULT 'aberto',
        resultado VARCHAR(30) NULL DEFAULT NULL,
        parecer_tecnico TEXT NULL,
        ajudantes_json LONGTEXT NULL,
        comentarios_json LONGTEXT NULL,
        data_abertura VARCHAR(40) NOT NULL,
        data_resolucao VARCHAR(40) NULL DEFAULT NULL,
        criado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP
      ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
    `);

    mysqlAtivo = true;
    console.log('✅ [MySQL] Conectado com sucesso em ' + dbConfig.host + ':' + dbConfig.port + '/' + targetDb);
  } catch (err) {
    mysqlAtivo = false;
    console.log('ℹ️ [Modo JSON GitHub Ativo] MySQL não detectado agora; salvando automaticamente em database/db_chamados.json.');
  }
}[cite: 2]

app.get('/api/status', async (req, res) => {
  try {
    if (!mysqlAtivo) await inicializarBancoMySQL();
    if (mysqlAtivo && pool) {
      await pool.query('SELECT 1');
      return res.json({ ok: true, mysql: true, host: dbConfig.host, database: dbConfig.database, msg: `Conectado à DB MySQL (${dbConfig.database}) no seu computador!` });
    }
    return res.json({ ok: true, mysql: false, host: 'Servidor Local (JSON GitHub)', database: 'database/db_chamados.json', msg: 'Servidor ativo (Sincronizando em database/db_chamados.json)!' });
  } catch (err) {
    return res.json({ ok: true, mysql: false, host: 'Servidor Local', database: 'database/db_chamados.json', msg: 'Servidor ativo com backup automático!' });
  }
});[cite: 2]

app.get('/api/dados', async (req, res) => {
  if (mysqlAtivo && pool) {
    try {
      const [chamadosRows] = await pool.query('SELECT * FROM chamados ORDER BY criado_em DESC');
      const [colabRows] = await pool.query('SELECT * FROM colaboradores ORDER BY criado_em ASC');
      const [configRows] = await pool.query('SELECT * FROM configuracoes_ti WHERE id = 1');

      const chamados = chamadosRows.map(r => ({
        id: r.id,
        setor: r.setor,
        responsavel: r.responsavel,
        categoria: r.categoria,
        descricao: r.descricao || '',
        status: r.status,
        resultado: r.resultado,
        parecerTecnico: r.parecer_tecnico || '',
        ajudantes: r.ajudantes_json ? JSON.parse(r.ajudantes_json) : [],
        comentarios: r.comentarios_json ? JSON.parse(r.comentarios_json) : [],
        dataAbertura: r.data_abertura,
        dataResolucao: r.data_resolucao
      }));

      return res.json({
        ok: true,
        chamados,
        colaboradores: colabRows,
        perfilTI: configRows[0] || null
      });
    } catch (err) {}
  }
  const backup = lerBackupJson();
  res.json({ ok: true, ...backup });
});[cite: 2]

app.post('/api/sincronizar', async (req, res) => {
  const { database, chamados = [], colaboradores = [], perfilTI = null } = req.body || {};
  salvarBackupJson({ database: database || dbConfig.database, chamados, colaboradores, perfilTI, atualizadoEm: new Date().toISOString() });

  if (database && database !== dbConfig.database) {
    dbConfig.database = database;
    await inicializarBancoMySQL(database);
  }

  if (mysqlAtivo && pool) {
    try {
      if (perfilTI) {
        await pool.query(
          `UPDATE configuracoes_ti SET nome_tecnico = ?, cargo_tecnico = ?, foto_ti = ? WHERE id = 1`,
          [perfilTI.nome || 'João Victor', perfilTI.cargo || 'Analista de Suporte TI', perfilTI.foto || null]
        );
      }
      for (const col of colaboradores) {
        await pool.query(
          `INSERT INTO colaboradores (id, nome, funcao)
           VALUES (?, ?, ?)
           ON DUPLICATE KEY UPDATE nome = VALUES(nome), funcao = VALUES(funcao)`,
          [col.id, col.nome, col.funcao || 'Colaborador TI']
        );
      }
      for (const c of chamados) {
        await pool.query(
          `INSERT INTO chamados (id, setor, responsavel, categoria, descricao, status, resultado, parecer_tecnico, ajudantes_json, comentarios_json, data_abertura, data_resolucao)
           VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
           ON DUPLICATE KEY UPDATE
             status = VALUES(status),
             resultado = VALUES(resultado),
             parecer_tecnico = VALUES(parecer_tecnico),
             ajudantes_json = VALUES(ajudantes_json),
             comentarios_json = VALUES(comentarios_json),
             data_resolucao = VALUES(data_resolucao)`,
          [
            c.id, c.setor, c.responsavel, c.categoria,
            c.descricao || '', c.status || 'aberto', c.resultado || null,
            c.parecerTecnico || '', JSON.stringify(c.ajudantes || []),
            JSON.stringify(c.comentarios || []), c.dataAbertura, c.dataResolucao || null
          ]
        );
      }
      return res.json({ ok: true, msg: `Dados sincronizados na DB MySQL (${dbConfig.database}) e em database/db_chamados.json!` });
    } catch (err) {}
  }

  res.json({ ok: true, msg: 'Dados sincronizados em database/db_chamados.json com sucesso!' });
});[cite: 2]

function obterIPsRedeLocal() {
  const interfaces = os.networkInterfaces();
  const ips = [];
  for (const name of Object.keys(interfaces)) {
    for (const iface of interfaces[name]) {
      if (iface.family === 'IPv4' && !iface.internal) {
        ips.push(iface.address);
      }
    }
  }
  return ips;
}[cite: 2]

